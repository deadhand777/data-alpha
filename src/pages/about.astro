---
import Layout from '../components/Layout.astro';
import { getEntry, render } from 'astro:content';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';

const about = (await getEntry('about', 'index'))!;
const { Content } = await render(about);
const base = import.meta.env.BASE_URL;
---

<Layout
  title={`${about.data.seoTitle} | Data Alpha`}
  description={about.data.description}
  path="/about/"
>
  <article class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <h1 class="mb-8 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl text-balance">{about.data.title}</h1>

    <AboutSection
      role={about.data.role}
      introduction={about.data.introduction}
      highlights={about.data.highlights}
    />

    <SkillsSection expertise={about.data.expertise} />

    <ExperienceSection
      experience={about.data.experience}
      education={about.data.education}
      cvUrl={about.data.cvUrl}
    />

    <div class="prose prose-invert prose-panel max-w-3xl">
      <Content />
    </div>

    <section class="mt-16 border-t border-white/5 pt-10" aria-labelledby="next-step-heading">
      <h2 id="next-step-heading" class="text-2xl font-bold text-text-primary">Explore the Work</h2>
      <p class="mt-3 max-w-2xl leading-7 text-text-secondary">
        See how these ideas translate into practical systems, or get in touch to discuss AI platforms, regulated delivery, and data strategy.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-md bg-accent-tech-dark px-4 py-2.5 text-sm font-semibold text-text-primary shadow-resting transition-all duration-200 hover:bg-accent-tech-deep hover:-translate-y-px hover:shadow-lifted" href={`${base}projects/contact-center`}>View a featured project</a>
        <a class="rounded-md border border-white/10 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors duration-200 hover:border-accent-tech hover:text-accent-tech-light hover:bg-white/5" href={`${base}contact`}>Get in touch</a>
        <a class="rounded-md border border-white/10 px-4 py-2.5 text-sm font-semibold text-text-secondary transition-colors duration-200 hover:border-accent-tech hover:text-accent-tech-light hover:bg-white/5" href={about.data.cvUrl} target="_blank" rel="noopener noreferrer">View full CV</a>
        <a class="px-2 py-2.5 text-sm font-semibold text-accent-tech-light hover:underline underline-offset-4" href={about.data.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="px-2 py-2.5 text-sm font-semibold text-accent-tech-light hover:underline underline-offset-4" href={about.data.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="px-2 py-2.5 text-sm font-semibold text-accent-tech-light hover:underline underline-offset-4" href={about.data.mediumUrl} target="_blank" rel="noopener noreferrer">Medium</a>
      </div>
    </section>
  </article>
</Layout>
