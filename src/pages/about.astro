                                                                                                        ---
import Layout from '../components/Layout.astro';
import SEO from '../components/SEO.astro';
import { getEntry } from 'astro:content';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';

const aboutPage = await getEntry('about', 'index');
const Content = aboutPage ? (await aboutPage.render()).Content : null;
const base = import.meta.env.BASE_URL;
---

{!aboutPage ? (
  <Layout>
    <SEO title="About | Data Alpha Portfolio" description="Learn more about Chris Schulz and his work in data and AI." path="/about" />
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-3xl font-bold text-gray-900 mb-8">About Me</h1>
      <p class="text-gray-600 mb-8">
        Data, AI, and finance expert sharing insights through blogging and
        project showcases. Passionate about making complex topics accessible.
      </p>
    </article>
  </Layout>
) : (
  <Layout>
    <SEO
      title={`${aboutPage.data.seoTitle} | Data Alpha Portfolio`}
      description={aboutPage.data.description}
      path="/about"
    />

    <article class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <h1 class="mb-8 text-4xl font-bold text-gray-900 sm:text-5xl">{aboutPage.data.title}</h1>

      <AboutSection
        role={aboutPage.data.role}
        introduction={aboutPage.data.introduction}
        highlights={aboutPage.data.highlights}
      />

      <SkillsSection expertise={aboutPage.data.expertise} />

      <ExperienceSection
        experience={aboutPage.data.experience}
        education={aboutPage.data.education}
        cvUrl={aboutPage.data.cvUrl}
      />

      {Content && (
        <div class="prose prose-slate max-w-3xl">
          <Content />
        </div>
      )}

      <section class="mt-16 border-t border-gray-200 pt-10" aria-labelledby="next-step-heading">
        <h2 id="next-step-heading" class="text-2xl font-bold text-gray-900">Explore the Work</h2>
        <p class="mt-3 max-w-2xl leading-7 text-gray-600">
          See how these ideas translate into practical systems, or get in touch to discuss AI platforms, regulated delivery, and data strategy.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="rounded-md bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700" href={`${base}projects/contact-center`}>View a featured project</a>
          <a class="rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-800 hover:border-gray-400 hover:bg-gray-50" href={`${base}contact`}>Get in touch</a>
          <a class="rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-800 hover:border-gray-400 hover:bg-gray-50" href={aboutPage.data.cvUrl} target="_blank" rel="noreferrer">View full CV</a>
          <a class="px-2 py-2.5 text-sm font-semibold text-accent-tech-dark hover:text-accent-tech" href={aboutPage.data.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="px-2 py-2.5 text-sm font-semibold text-accent-tech-dark hover:text-accent-tech" href={aboutPage.data.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </section>
    </article>
  </Layout>
)}
