---
import Layout from '../../components/Layout.astro';
import ArticleFooter from '../../components/ArticleFooter.astro';
import { getCollection, render } from 'astro:content';
import { formatProjectDate } from '../../lib/project-date';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const ordered = [...projects].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return ordered.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      // The next-older write-up, wrapping to the newest, so no project page is a dead end.
      next: ordered.length > 1 ? (ordered[index + 1] ?? ordered[0]) : undefined,
      ordered
    }
  }));
}

const { project, next, ordered } = Astro.props;

const related = ordered
  .filter((entry) => entry.id !== project.id && entry.id !== next?.id)
  .slice(0, 2);
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;

const { title, description, tags, techStack, demoUrl, sourceUrl, pubDate, updatedDate, period } =
  project.data;

// `updatedDate` only earns a line when it actually differs from publication.
const showUpdated = updatedDate && updatedDate.valueOf() !== pubDate.valueOf();
---

<Layout
  title={`${title} | Data Alpha`}
  description={description}
  path={`/projects/${project.id}/`}
  article={{
    headline: title,
    datePublished: pubDate,
    dateModified: updatedDate,
    tags,
    type: 'CreativeWork'
  }}
>
  <article class="max-w-3xl mx-auto py-12">
    <header class="mb-10">
      <a
        href={`${base}projects`}
        class="text-sm font-medium text-accent-tech-light transition-colors hover:underline underline-offset-4"
      >
        &larr; All projects
      </a>

      <h1 class="mt-5 text-4xl font-bold tracking-tight text-text-primary sm:text-5xl text-balance">{title}</h1>

      <p class="mt-5 text-lg leading-relaxed text-text-secondary text-pretty">{description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-text-muted">
        {period ? (
          <span>{period}</span>
        ) : (
          <time datetime={pubDate.toISOString()}>{formatProjectDate(pubDate, undefined, 'long')}</time>
        )}
        {showUpdated && (
          <>
            <span aria-hidden="true" class="text-bg-surface-light">/</span>
            <span class="text-accent-success-light">
              Updated {formatProjectDate(updatedDate, undefined, 'long')}
            </span>
          </>
        )}
        {demoUrl && (
          <>
            <span aria-hidden="true" class="text-bg-surface-light">/</span>
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-accent-tech-light transition-colors hover:underline underline-offset-4"
            >
              Live demo<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </>
        )}
        {sourceUrl && (
          <>
            <span aria-hidden="true" class="text-bg-surface-light">/</span>
            <a
              href={sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-accent-tech-light transition-colors hover:underline underline-offset-4"
            >
              Source code<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </>
        )}
      </div>

      {techStack.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technology stack">
          {techStack.map((tech) => (
            <li class="rounded bg-bg-surface-light px-2 py-0.5 text-xs font-medium tracking-wide text-accent-tech-pale">
              {tech}
            </li>
          ))}
        </ul>
      )}

      {tags.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-2" aria-label="Topics">
          {tags.map((tag) => (
            <li class="rounded bg-bg-surface-light px-2 py-0.5 text-xs font-medium tracking-wide text-accent-tech-pale">
              #{tag}
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose prose-lg prose-invert prose-panel max-w-none">
      <Content />
    </div>

    <ArticleFooter next={next} related={related} basePath="projects" nextLabel="Next project" />
  </article>
</Layout>
