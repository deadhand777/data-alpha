---
import Layout from '../../components/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getEntry, getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { slug } = Astro.props;

if (!slug) {
  return Astro.redirect('/projects');
}

const project = await getEntry('projects', slug);

if (!project) {
  return Astro.redirect('/projects');
}
---

<Layout>
  <SEO
    title={`${project.data.title} | Personal Website`}
    description={project.data.description}
  />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{project.data.title}</h1>
      <div class="flex flex-wrap gap-4 mb-6 text-sm text-gray-500">
        <span>{new Date(project.data.pubDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {project.data.updatedDate && (
          <span class="mx-1">•</span>
          <span>{new Date(project.data.updatedDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        )}
        {project.data.tags.map((tag) => (
          <span key={tag} class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="space-y-8">
      {/* Project description */}
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Overview</h2>
        <p class="text-gray-700 mb-6">{project.data.description}</p>
      </section>

      {/* Technical details */}
      {project.data.techStack.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Technical Stack</h2>
          <div class="flex flex-wrap gap-4 mb-6">
            {project.data.techStack.map((tech) => (
              <div key={tech} class="flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-md text-sm font-medium">
                <span class="block w-3 h-3 bg-indigo-600 rounded"></span>
                <span>{tech}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Tags */}
      {project.data.tags.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Tags</h2>
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.tags.map((tag) => (
              <span key={tag} class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">
                #{tag}
              </span>
            ))}
          </div>
        </section>
      )}

      {/* Links */}
      {((project.data.demoUrl || project.data.sourceUrl) && (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Links</h2>
          <div class="space-y-4">
            {project.data.demoUrl && (
              <div class="flex items-center gap-3">
                <span class="block w-3 h-3 bg-indigo-600 rounded"></span>
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-indigo-600 hover:text-indigo-800 font-medium transition-colors"
                >
                  Live Demo
                </a>
              </div>
            )}
            {project.data.sourceUrl && (
              <div class="flex items-center gap-3">
                <span class="block w-3 h-3 bg-gray-400 rounded"></span>
                <a
                  href={project.data.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 hover:text-gray-800 font-medium transition-colors"
                >
                  Source Code
                </a>
              </div>
            )}
          </div>
        </section>
      ))}

      {/* Project content (if any) */}
      {project.body && (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Details</h2>
          <div class="prose prose-lg prose-gray max-w-none">
            <p set:html={project.body} />
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>