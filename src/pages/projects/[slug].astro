---
import Layout from '../../components/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatProjectDate } from '../../lib/project-date';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;

if (!project) {
  return Astro.redirect(`${import.meta.env.BASE_URL}projects`);
}

const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Data Alpha`}
  description={project.data.description}
  path={`/projects/${project.id}/`}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary mb-4 text-balance">{project.data.title}</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-6 text-sm text-text-muted">
        <span>{formatProjectDate(project.data.pubDate, project.data.period, 'long')}</span>
        {project.data.updatedDate && (
          <span class="mx-1">•</span>
          <span>Updated {formatProjectDate(project.data.updatedDate, undefined, 'long')}</span>
        )}
        {project.data.tags.map((tag) => (
          <span class="bg-bg-surface-light text-accent-tech-pale text-xs font-medium tracking-wide px-2.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="space-y-8">
      {/* Project description */}
      <section>
        <h2 class="text-2xl font-bold text-text-primary mb-4">Overview</h2>
        <p class="leading-relaxed text-text-secondary mb-6">{project.data.description}</p>
      </section>

      {/* Technical details */}
      {project.data.techStack.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">Technical Stack</h2>
          <div class="flex flex-wrap gap-4 mb-6">
            {project.data.techStack.map((tech) => (
              <div class="flex items-center gap-2 bg-bg-surface border border-white/5 px-4 py-2 rounded-md text-sm font-medium text-text-secondary">
                <span class="block w-1.5 h-1.5 bg-accent-tech rounded-full" aria-hidden="true"></span>
                <span>{tech}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Tags */}
      {project.data.tags.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">Tags</h2>
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.tags.map((tag) => (
              <span class="bg-bg-surface-light text-accent-tech-pale text-xs font-medium tracking-wide px-2.5 py-0.5 rounded">
                #{tag}
              </span>
            ))}
          </div>
        </section>
      )}

      {/* Links */}
      {((project.data.demoUrl || project.data.sourceUrl) && (
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">Links</h2>
          <div class="space-y-4">
            {project.data.demoUrl && (
              <div class="flex items-center gap-3">
                <span class="block w-1.5 h-1.5 bg-accent-tech rounded-full" aria-hidden="true"></span>
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent-tech-light hover:underline underline-offset-4 font-medium transition-colors"
                >
                  Live Demo
                </a>
              </div>
            )}
            {project.data.sourceUrl && (
              <div class="flex items-center gap-3">
                <span class="block w-1.5 h-1.5 bg-bg-surface-light rounded-full" aria-hidden="true"></span>
                <a
                  href={project.data.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent-tech-light hover:underline underline-offset-4 font-medium transition-colors"
                >
                  Source Code
                </a>
              </div>
            )}
          </div>
        </section>
      ))}

      {/* Project content (if any) */}
      {project.body && (
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">Details</h2>
          <div class="prose prose-lg prose-invert prose-panel max-w-none">
            <Content />
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
