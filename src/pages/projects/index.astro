---
import Layout from '../../components/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Newest first; copy before sorting so the collection array stays untouched for other pages.
const sortedProjects = [...projects].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Projects | Data Alpha"
  description="Systems built for production: agent platforms, data foundations, and applied machine learning in regulated financial services."
  path="/projects/"
>
  <section class="py-12">
    <h1 class="text-4xl font-bold tracking-tight text-text-primary text-balance">Projects</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-secondary text-pretty">
      Selected work on production AI agents, data platforms, and open-source engineering, most of it
      for regulated financial services. <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="text-accent-tech-light underline decoration-accent-tech/40 underline-offset-4 transition-colors hover:decoration-accent-tech-light"
        >Ask me</a
      > for more implementation detail than these pages can carry.
    </p>

    {sortedProjects.length > 0 ? (
      <ul class="mt-12 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedProjects.map((project) => (
          <li class="h-full">
            <ProjectCard project={project} headingLevel="h2" />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-12 text-text-muted">No projects published yet.</p>
    )}
  </section>
</Layout>
