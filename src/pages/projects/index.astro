---
import Layout from '../../components/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort by date (newest first)
const sortedProjects = projects
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <SEO
    title="Projects | Data Alpha Portfolio"
    description="Explore my projects showcasing data, AI, and finance applications"
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Projects</h1>
    <p class="text-gray-600 mb-8">
      Showcase of my work in data analysis, artificial intelligence,
      and financial modeling through open-source projects and case studies.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortedProjects.map((project) => (
        <article key={project.slug} class="bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-3">{project.data.title}</h2>
            <p class="text-gray-600 mb-4 line-clamp-3">{project.data.description}</p>
            {project.data.techStack.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4 text-xs">
                {project.data.techStack.map((tech) => (
                  <span key={tech} class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded">
                    {tech}
                  </span>
                ))}
              </div>
            )}
            <div class="flex flex-wrap gap-2 mb-4 text-xs">
              {project.data.tags.map((tag) => (
                <span key={tag} class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
            </div>
            <div class="mt-4 space-x-3">
              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md transition-colors flex-1"
                >
                  Demo
                </a>
              )}
              {project.data.sourceUrl && (
                <a
                  href={project.data.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-indigo-600 hover:bg-indigo-50 text-indigo-600 font-medium py-2 px-4 rounded-md transition-colors flex-1"
                >
                  Source
                </a>
              )}
            </div>
            <div class="flex items-center justify-between text-sm text-gray-500 mt-4">
              <span>{new Date(project.data.pubDate).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <a href={`${import.meta.env.BASE_URL}projects/${project.slug}`} class="font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
                View project →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {sortedProjects.length === 0 && (
      <p class="text-center text-gray-500 py-8">No projects found. Check back soon for new additions!</p>
    )}
  </section>
</Layout>
