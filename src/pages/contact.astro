---
import Layout from '../components/Layout.astro';
import SEO from '../components/SEO.astro';
import { ContactForm } from '../components/ContactForm.tsx';
---
<Layout>
  <SEO
    title="Contact | Personal Website"
    description="Get in touch with questions, collaboration inquiries, or feedback"
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Contact Me</h1>
    <p class="text-gray-600 mb-8">
      Have a question, collaboration idea, or just want to say hello?
      I'd love to hear from you!
    </p>

    <div class="bg-white rounded-lg border border-gray-200 p-8 shadow-sm">
      <ContactForm />
    </div>
  </section>
</Layout>