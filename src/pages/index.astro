---
import Layout from '../components/Layout.astro';
import { HeroSection } from '../components/HeroSection.tsx';
import { BlogPreview } from '../components/BlogPreview.tsx';
import { ProjectGrid } from '../components/ProjectGrid.tsx';
import { getCollection } from 'astro:content';
import { getLatestPosts } from '../lib/publication-catalog';
import { formatProjectDate } from '../lib/project-date';

const projects = await getCollection('projects');

// Sort blog posts by date (newest first) and map to shape expected by BlogPreview
const sortedBlogPosts = (await getLatestPosts(3)).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  tags: post.data.tags,
  slug: post.id
}));

// Sort projects by date (newest first) and map to shape expected by ProjectGrid
const sortedProjects = projects
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3) // Show latest 3 projects
  .map(project => ({
    title: project.data.title,
    description: project.data.description,
    dateLabel: formatProjectDate(project.data.pubDate, project.data.period),
    tags: project.data.tags,
    slug: project.id,
    demoUrl: project.data.demoUrl,
    sourceUrl: project.data.sourceUrl,
    techStack: project.data.techStack
  }));
---

<Layout
  title="Data Alpha — Chris Schulz on production AI, data, and finance"
  description="Writing on taking AI from experiment to production in regulated financial services: architecture, evaluation, governance, and the tradeoffs that transfer."
  path="/"
>
  <HeroSection />

  <div class="mt-16">
    <BlogPreview posts={sortedBlogPosts} />
  </div>

  <div class="mt-16">
    <ProjectGrid projects={sortedProjects} />
  </div>
</Layout>
