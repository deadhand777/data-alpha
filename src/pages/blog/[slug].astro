---
import Layout from '../../components/Layout.astro';
import ArticleRail from '../../components/ArticleRail.astro';
import ArticleFooter from '../../components/ArticleFooter.astro';
import { render } from 'astro:content';
import {
  getArticleContext,
  getPublishedPosts
} from '../../lib/publication-catalog';

export async function getStaticPaths() {
  const blogPosts = await getPublishedPosts();
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { series, seriesIndex, nextInSeries, related } =
  await getArticleContext(post, 2);

const words = post.body?.split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.round(words / 220));

const heroImage = post.data.heroImage?.startsWith('http')
  ? post.data.heroImage
  : post.data.heroImage
    ? `${import.meta.env.BASE_URL}${post.data.heroImage.replace(/^\//, '')}`
    : undefined;

const dateFormat = { year: 'numeric', month: 'long', day: 'numeric' } as const;
---

<Layout
  title={`${post.data.title} | Data Alpha`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  image={`/images/og/${post.id}.png`}
  article={{
    headline: post.data.title,
    datePublished: post.data.pubDate,
    dateModified: post.data.updatedDate,
    tags: post.data.tags
  }}
>
  <div class="py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
    <article class="max-w-3xl min-w-0">
      <header class="mb-10">
        {post.data.series && seriesIndex >= 0 && (
          <p class="mb-4 text-sm font-medium text-accent-tech-light">
            {post.data.series} · Part {seriesIndex + 1} of {series.length}
          </p>
        )}

        <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl text-balance">
          {post.data.title}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-text-secondary text-pretty">
          {post.data.description}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-text-muted">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString(undefined, dateFormat)}
          </time>
          <span aria-hidden="true" class="text-bg-surface-light">/</span>
          <span>{readingMinutes} min read</span>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true" class="text-bg-surface-light">/</span>
              <span class="text-accent-success-light">
                Updated {post.data.updatedDate.toLocaleDateString(undefined, dateFormat)}
              </span>
            </>
          )}
        </div>

        {post.data.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="rounded bg-bg-surface-light px-2.5 py-0.5 text-xs font-medium tracking-wide text-accent-tech-pale">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </header>

      {heroImage && (
        <figure class="mb-10">
          <img
            src={heroImage}
            alt={`${post.data.title} illustration`}
            width="1200"
            height="675"
            class="w-full aspect-video object-cover rounded-lg border border-white/5 shadow-resting"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}

      <ArticleRail headings={headings} variant="inline" />

      <div class="prose prose-lg prose-invert prose-panel max-w-none">
        <Content />
      </div>

      <ArticleFooter next={nextInSeries} related={related} seriesName={post.data.series} />
    </article>

    <ArticleRail headings={headings} variant="sticky" />
  </div>
</Layout>
