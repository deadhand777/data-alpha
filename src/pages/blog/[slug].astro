---
import Layout from '../../components/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post: blogPost } = Astro.props;

if (!blogPost) {
  return Astro.redirect(`${import.meta.env.BASE_URL}blog`);
}

const { Content } = await blogPost.render();
---

<Layout>
  <SEO
    title={`${blogPost.data.title} | Data Alpha Portfolio`}
    description={blogPost.data.description}
  />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose prose-lg prose-indigo max-w-none">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{blogPost.data.title}</h1>
      <div class="flex flex-wrap gap-4 mb-6 text-sm text-gray-500">
        <span>{new Date(blogPost.data.pubDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {blogPost.data.updatedDate && (
          <>
            <span class="mx-1">•</span>
            <span>{new Date(blogPost.data.updatedDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </>
        )}
        {blogPost.data.tags.map((tag) => (
          <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="prose prose-lg prose-indigo max-w-none">
      <Content />
    </div>

    <div class="mt-8">
      <p>
        <strong>Tags:</strong> {blogPost.data.tags.map(tag => (
          <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </p>
    </div>
  </article>
</Layout>
