---
<footer class="bg-gray-900 text-gray-200 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 gap-8 md:grid-cols-3">
    <div>
      <h3 class="text-lg font-semibold mb-4">About Me</h3>
      <p class="text-sm">
        Data, AI, and finance expert sharing insights through blogging and
        project showcases. Passionate about making complex topics accessible.
      </p>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-4">Connect</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="https://github.com/deadhand777" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/chris-schulz-ai-first/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a></li>
        <li><a href="https://twitter.com/chrisschulz133" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Twitter</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-4">Resources</h3>
      <ul class="space-y-2 text-sm">
        <li><a href={`${import.meta.env.BASE_URL}blog`} class="hover:text-white transition-colors">Blog</a></li>
        <li><a href={`${import.meta.env.BASE_URL}projects`} class="hover:text-white transition-colors">Projects</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-800 mt-12 pt-8 text-center text-sm">
    &copy; <span id="year"></span> Data Alpha Portfolio. All rights reserved.
  </div>
</footer>

<script>
  const year = document.getElementById('year');
  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>
