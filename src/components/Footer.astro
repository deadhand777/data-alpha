<footer class="border-t border-white/5 bg-bg-primary text-text-secondary py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 gap-8 md:grid-cols-3">
    <div>
      <h3 class="text-lg font-semibold text-text-primary mb-4">Chris Schulz</h3>
      <p class="text-sm leading-relaxed">
        Head of Data &amp; AI. I take AI from experiment to production — engineering, product strategy,
        and governance for systems that hold up in regulated financial services.
      </p>
    </div>
    <div>
      <h3 class="text-lg font-semibold text-text-primary mb-4">Connect</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="https://github.com/deadhand777" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-tech-light transition-colors">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/chris-schulz-ai-first/" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-tech-light transition-colors">LinkedIn</a></li>
        <li><a href="https://github.com/deadhand777/cs_cv/blob/main/cv/cv.pdf" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-tech-light transition-colors">Full CV</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold text-text-primary mb-4">Resources</h3>
      <ul class="space-y-2 text-sm">
        <li><a href={`${import.meta.env.BASE_URL}blog`} class="text-text-secondary hover:text-accent-tech-light transition-colors">Blog</a></li>
        <li><a href={`${import.meta.env.BASE_URL}projects`} class="text-text-secondary hover:text-accent-tech-light transition-colors">Projects</a></li>
        <li><a href={`${import.meta.env.BASE_URL}rss.xml`} class="text-text-secondary hover:text-accent-tech-light transition-colors">RSS feed</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5 mt-12 pt-8 text-center text-sm text-text-muted">
    &copy; <span id="year"></span> Data Alpha Portfolio. All rights reserved.
  </div>
</footer>

<script>
  const year = document.getElementById('year');
  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>
