---
---
<footer class="bg-gray-900 text-gray-200 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 gap-8 md:grid-cols-4">
    <div>
      <h3 class="text-lg font-semibold mb-4">About Me</h3>
      <p class="text-sm">
        Data, AI, and finance expert sharing insights through blogging and
        project showcases. Passionate about making complex topics accessible.
      </p>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-4">Connect</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="#" class="hover:text-white transition-colors">GitHub</a></li>
        <li><a href="#" class="hover:text-white transition-colors">LinkedIn</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Twitter</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Email</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-4">Resources</h3>
      <ul class="space-y-2 text-sm">
        <li><a href={`${import.meta.env.BASE_URL}blog`} class="hover:text-white transition-colors">Blog</a></li>
        <li><a href={`${import.meta.env.BASE_URL}projects`} class="hover:text-white transition-colors">Projects</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Newsletter</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold mb-4">Newsletter</h3>
      <form class="space-y-2 text-sm">
        <input
          type="email"
          placeholder="your@email.com"
          class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
        />
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
          Subscribe
        </button>
      </form>
    </div>
  </div>
  <div class="border-t border-gray-800 mt-12 pt-8 text-center text-sm">
    &copy; <span id="year"></span> Personal Website. All rights reserved.
  </div>
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>
