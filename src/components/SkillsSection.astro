---
interface ExpertiseGroup {
  title: string;
  description: string;
  tools: string[];
}

interface Props {
  expertise: ExpertiseGroup[];
}

const { expertise } = Astro.props;
---
{expertise.length > 0 && (
  <section class="mb-16" aria-labelledby="expertise-heading">
    <div class="mb-8 max-w-2xl">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent-success-dark">Capabilities</p>
      <h2 id="expertise-heading" class="text-3xl font-bold text-gray-900">What I Build</h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {expertise.map((group) => (
        <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900">{group.title}</h3>
          <p class="mt-3 leading-7 text-gray-600">{group.description}</p>
          {group.tools.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${group.title} technologies`}>
              {group.tools.map((tool) => (
                <li class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">{tool}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>
)}
