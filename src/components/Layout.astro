---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path with leading and trailing slash, e.g. `/blog/my-post/` */
  path?: string;
  /** Site-relative image path; defaults to the site-wide OG card. */
  image?: string;
  /** Present on article pages; switches the JSON-LD off WebSite. */
  article?: {
    /** Bare article title, without the site suffix carried by `title`. */
    headline: string;
    datePublished: Date;
    dateModified?: Date;
    tags?: string[];
    /** schema.org type; project write-ups are CreativeWork, posts are BlogPosting. */
    type?: 'BlogPosting' | 'CreativeWork';
  };
}

const {
  title = 'Data Alpha Portfolio',
  description = 'Data, AI, and finance insights from a practitioner taking AI from experiment to production in regulated financial services.',
  path = '/',
  image = '/images/og/default.png',
  article
} = Astro.props;

const SITE = import.meta.env.SITE.replace(/\/$/, '');
const canonical = `${SITE}${path}`;
const imageUrl = `${SITE}${image}`;

const author = { name: 'Chris Schulz', url: 'https://github.com/deadhand777' };

const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': article.type ?? 'BlogPosting',
      '@id': canonical,
      headline: article.headline,
      description,
      url: canonical,
      image: imageUrl,
      datePublished: article.datePublished.toISOString(),
      ...(article.dateModified && { dateModified: article.dateModified.toISOString() }),
      ...(article.tags?.length && { keywords: article.tags.join(', ') }),
      author: { '@type': 'Person', name: author.name, url: author.url },
      publisher: { '@type': 'Person', name: author.name, url: author.url }
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${SITE}/`,
      name: 'Data Alpha',
      description,
      url: `${SITE}/`,
      author: { '@type': 'Person', name: author.name, url: author.url }
    };
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Data Alpha" href={`${import.meta.env.BASE_URL}rss.xml`} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Data Alpha" />
    {article && <meta property="article:published_time" content={article.datePublished.toISOString()} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-bg-primary text-text-secondary antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-tech-dark focus:px-4 focus:py-2 focus:text-text-primary"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
