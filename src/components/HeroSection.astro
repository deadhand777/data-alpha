---
const base = import.meta.env.BASE_URL;
---
<section class="relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl md:text-6xl mb-6 text-balance">
        Production AI that holds up in practice
      </h1>
      <p class="text-xl leading-relaxed text-text-secondary max-w-2xl mx-auto">
        Hands-on writing about architecture, evaluation, governance, and the
        operating decisions behind AI in regulated financial services.
      </p>
      <div class="mt-8 flex justify-center space-x-4">
        <a
          href={`${base}blog`}
          class="bg-accent-tech-dark hover:bg-accent-tech-deep text-text-primary font-medium py-3 px-6 rounded-md shadow-resting hover:shadow-lifted hover:-translate-y-px transition-all duration-200"
        >
          Read articles
        </a>
        <a
          href={`${base}projects`}
          class="border border-accent-tech text-accent-tech-light hover:text-accent-tech-pale hover:bg-bg-surface-light hover:border-accent-tech-light font-medium py-3 px-6 rounded-md transition-colors duration-200"
        >
          View projects
        </a>
      </div>
    </div>
  </div>
</section>
