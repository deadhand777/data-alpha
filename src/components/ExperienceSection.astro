---
interface ExperienceSummary {
  summary: string;
  focus: string[];
}

interface EducationSummary {
  summary: string;
  foundation: string[];
}

interface Props {
  experience: ExperienceSummary;
  education: EducationSummary;
  cvUrl: string;
}

const { experience, education, cvUrl } = Astro.props;
---
<section class="mb-16 border-y border-white/5 py-12" aria-labelledby="background-heading">
  <div class="mb-8 max-w-2xl">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent-tech-light">Background</p>
    <h2 id="background-heading" class="text-3xl font-bold text-text-primary">Experience & Education</h2>
  </div>

  <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
    <section aria-labelledby="experience-heading">
      <h3 id="experience-heading" class="text-xl font-bold text-text-primary">Selected Experience</h3>
      <p class="mt-4 leading-7 text-text-secondary">{experience.summary}</p>
      <ul class="mt-5 space-y-3 text-sm text-text-secondary">
        {experience.focus.map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-accent-tech" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="education-heading">
      <h3 id="education-heading" class="text-xl font-bold text-text-primary">Education</h3>
      <p class="mt-4 leading-7 text-text-secondary">{education.summary}</p>
      <ul class="mt-5 space-y-3 text-sm text-text-secondary">
        {education.foundation.map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-accent-tech" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <p class="mt-10 text-sm text-text-muted">
    Employment history, academic details, and the complete technical profile are available in the
    <a class="font-semibold text-accent-tech-light underline decoration-accent-tech/40 underline-offset-4 hover:decoration-accent-tech-light" href={cvUrl} target="_blank" rel="noopener noreferrer">full CV</a>.
  </p>
</section>
