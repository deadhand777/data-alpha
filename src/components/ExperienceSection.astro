---
interface ExperienceSummary {
  summary: string;
  focus: string[];
}

interface EducationSummary {
  summary: string;
  foundation: string[];
}

interface Props {
  experience: ExperienceSummary;
  education: EducationSummary;
  cvUrl: string;
}

const { experience, education, cvUrl } = Astro.props;
---
<section class="mb-16 border-y border-gray-200 py-12" aria-labelledby="background-heading">
  <div class="mb-8 max-w-2xl">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent-tech-dark">Background</p>
    <h2 id="background-heading" class="text-3xl font-bold text-gray-900">Experience & Education</h2>
  </div>

  <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
    <section aria-labelledby="experience-heading">
      <h3 id="experience-heading" class="text-xl font-bold text-gray-900">Selected Experience</h3>
      <p class="mt-4 leading-7 text-gray-600">{experience.summary}</p>
      <ul class="mt-5 space-y-3 text-sm text-gray-700">
        {experience.focus.map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-accent-tech" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="education-heading">
      <h3 id="education-heading" class="text-xl font-bold text-gray-900">Education</h3>
      <p class="mt-4 leading-7 text-gray-600">{education.summary}</p>
      <ul class="mt-5 space-y-3 text-sm text-gray-700">
        {education.foundation.map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-accent-success" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <p class="mt-10 text-sm text-gray-600">
    Employment history, academic details, and the complete technical profile are available in the
    <a class="font-semibold text-accent-tech-dark underline decoration-blue-200 underline-offset-4 hover:text-accent-tech" href={cvUrl} target="_blank" rel="noreferrer">full CV</a>.
  </p>
</section>
