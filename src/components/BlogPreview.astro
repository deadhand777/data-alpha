---
interface Post {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const dateFormat = { year: 'numeric', month: 'short', day: 'numeric' } as const;
---
<section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-text-primary mb-6">
      Latest Articles
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <div
          class="bg-bg-surface/90 backdrop-blur-sm border border-white/5 rounded-lg overflow-hidden shadow-resting hover:border-white/10 hover:shadow-lifted transition-all duration-300 group"
        >
          <div class="p-8">
            <h3 class="text-xl font-semibold text-text-primary tracking-tight mb-4">
              {post.title}
            </h3>
            <p class="text-text-secondary text-sm line-clamp-3 mb-5 leading-relaxed">
              {post.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-5 text-xs">
              {post.tags.map((tag) => (
                <span class="bg-bg-surface-light text-accent-tech-pale text-xs font-medium tracking-wide px-2 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
            </div>
            <div class="flex items-center justify-between text-xs text-text-muted group-hover:text-text-secondary transition-colors">
              <span>{post.pubDate.toLocaleDateString(undefined, dateFormat)}</span>
              <a
                href={`${base}blog/${post.slug}`}
                class="font-medium text-accent-tech-light hover:underline underline-offset-4 transition-colors"
              >
                Read more &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a
        href={`${base}blog`}
        class="text-accent-tech-light hover:underline underline-offset-4 font-medium transition-colors"
      >
        View All Blog Posts &rarr;
      </a>
    </div>
  </div>
</section>
