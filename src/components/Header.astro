---
const base = import.meta.env.BASE_URL;
const pathname = new URL(Astro.url).pathname;

// pathname carries the deploy base ('/data-alpha/blog'), so compare against it.
const path = pathname.replace(base.replace(/\/$/, ''), '') || '/';

const links = [
  { href: base, label: 'Home', active: path === '/' },
  { href: `${base}blog`, label: 'Blog', active: path.startsWith('/blog') },
  { href: `${base}projects`, label: 'Projects', active: path.startsWith('/projects') },
  { href: `${base}about`, label: 'About', active: path.startsWith('/about') },
  { href: `${base}contact`, label: 'Contact', active: path.startsWith('/contact') }
];
---
<header class="bg-bg-primary/90 backdrop-blur-sm border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex h-20 items-center justify-between ">
    {/* Brand Logo with Data Accent */}
    <a href={base} class="flex items-center space-x-3">
      <span class="text-2xl font-semibold text-text-primary tracking-tight">
        Data Alpha
      </span>
      <span class="text-accent-tech-light">Portfolio</span>
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden md:flex space-x-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          class={`text-sm font-medium border-b-2 pb-1 transition-colors duration-200 ${
            link.active
              ? 'text-accent-tech-light border-accent-tech'
              : 'text-text-secondary border-transparent hover:text-accent-tech-light hover:border-accent-tech/40'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* Mobile Menu Button */}
    <button id="mobile-menu-button"
            class="md:hidden p-2 rounded-md text-text-secondary hover:text-accent-tech-light hover:bg-accent-tech/10 focus:outline-none focus:ring-2 focus:ring-accent-tech"
            aria-label="Open main menu"
            aria-controls="mobile-menu"
            aria-expanded="false">
      <svg data-menu-icon class="h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg data-close-icon class="hidden h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu (hidden by default) -->
<nav id="mobile-menu" aria-label="Mobile navigation" class="md:hidden hidden border-b border-white/5 bg-bg-primary/95 backdrop-blur-sm">
  <div class="px-4 pt-2 pb-3 space-y-1">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.active ? 'page' : undefined}
        class={`block rounded-md px-3 py-2 text-base font-medium transition-colors ${
          link.active
            ? 'text-accent-tech-light bg-accent-tech/10'
            : 'text-text-secondary hover:text-accent-tech-light hover:bg-white/5'
        }`}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const menuIcon = button.querySelector('[data-menu-icon]');
    const closeIcon = button.querySelector('[data-close-icon]');

    const setMenuOpen = (isOpen: boolean, restoreFocus = false) => {
      menu.classList.toggle('hidden', !isOpen);
      button.setAttribute('aria-expanded', String(isOpen));
      button.setAttribute('aria-label', isOpen ? 'Close main menu' : 'Open main menu');
      menuIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);

      if (restoreFocus) button.focus();
    };

    button.addEventListener('click', () => {
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false, true);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) setMenuOpen(false);
    });
  }
</script>
