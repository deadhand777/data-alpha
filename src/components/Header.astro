---
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = new URL(Astro.url).pathname;
---
<header class="bg-bg-primary/90 backdrop-blur-sm border-b border-gray-100/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex h-20 items-center justify-between border-b border-gray-100/25">
    {/* Brand Logo with Data Accent */}
    <a href={base} class="flex items-center space-x-3">
      <span class="text-2xl font-semibold text-text-primary tracking-tighter">
        Data Alpha
      </span>
      <span class="text-accent-tech">Portfolio</span>
      <span class="flex h-4 w-4 items-center justify-center">
        <div class="w-1.5 h-1.5 bg-accent-success rounded-full"></div>
      </span>
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden md:flex space-x-6">
      <a
        href={base}
        class={`
          flex-1 text-center text-sm font-medium
          transition-all duration-200
          ${pathname === '/' ? 'text-accent-success border-b-2 border-accent-success' : 'text-text-secondary hover:text-accent-success hover:border-b-2 border-gray-100'}
        `}
      >
        Home
      </a>
      <a
        href={`${base}blog`}
        class={`
          flex-1 text-center text-sm font-medium
          transition-all duration-200
          ${pathname.startsWith('/blog') ? 'text-accent-success border-b-2 border-accent-success' : 'text-text-secondary hover:text-accent-success hover:border-b-2 border-gray-100'}
        `}
      >
        Blog
      </a>
      <a
        href={`${base}projects`}
        class={`
          flex-1 text-center text-sm font-medium
          transition-all duration-200
          ${pathname.startsWith('/projects') ? 'text-accent-success border-b-2 border-accent-success' : 'text-text-secondary hover:text-accent-success hover:border-b-2 border-gray-100'}
        `}
      >
        Projects
      </a>
      <a
        href={`${base}about`}
        class={`
          flex-1 text-center text-sm font-medium
          transition-all duration-200
          ${pathname === '/about' ? 'text-accent-success border-b-2 border-accent-success' : 'text-text-secondary hover:text-accent-success hover:border-b-2 border-gray-100'}
        `}
      >
        About
      </a>
      <a
        href={`${base}contact`}
        class={`
          flex-1 text-center text-sm font-medium
          transition-all duration-200
          ${pathname === '/contact' ? 'text-accent-success border-b-2 border-accent-success' : 'text-text-secondary hover:text-accent-success hover:border-b-2 border-gray-100'}
        `}
      >
        Contact
      </a>
    </nav>

    {/* Mobile Menu Button */}
    <button id="mobile-menu-button"
            class="md:hidden p-2 rounded-md text-text-secondary hover:text-accent-success hover:bg-accent-success/10 focus:outline-none focus:ring-2 focus:ring-accent-success"
            aria-label="Open main menu"
            aria-expanded="false">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu (hidden by default) -->
<div id="mobile-menu" class="md:hidden hidden">
  <div class="px-2 pt-2 pb-3 space-y-1">
    <a
      href={base}
      class="block px-3 py-2 rounded-md text-base font-medium
             {pathname === '/' ? 'text-accent-success bg-accent-success/10' : 'text-text-secondary hover:text-accent-success'}"
    >
      Home
    </a>
    <a
      href={`${base}blog`}
      class="block px-3 py-2 rounded-md text-base font-medium
             {pathname.startsWith('/blog') ? 'text-accent-success bg-accent-success/10' : 'text-text-secondary hover:text-accent-success'}"
    >
      Blog
    </a>
    <a
      href={`${base}projects`}
      class="block px-3 py-2 rounded-md text-base font-medium
             {pathname.startsWith('/projects') ? 'text-accent-success bg-accent-success/10' : 'text-text-secondary hover:text-accent-success'}"
    >
      Projects
    </a>
    <a
      href={`${base}about`}
      class="block px-3 py-2 rounded-md text-base font-medium
             {pathname === '/about' ? 'text-accent-success bg-accent-success/10' : 'text-text-secondary hover:text-accent-success'}"
    >
      About
    </a>
    <a
      href={`${base}contact`}
      class="block px-3 py-2 rounded-md text-base font-medium
             {pathname === '/contact' ? 'text-accent-success bg-accent-success/10' : 'text-text-secondary hover:text-accent-success'}"
    >
      Contact
    </a>
  </div>
</div>

<script>
  // Mobile menu toggle functionality
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (button && menu) {
      button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        // Toggle aria-expanded attribute for accessibility
        const isExpanded = button.getAttribute('aria-expanded') === 'true' || false;
        button.setAttribute('aria-expanded', String(!isExpanded));
      });
    }
  });
</script>